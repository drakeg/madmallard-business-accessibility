# Generate for first Docker administrator setup: openssl rand -hex 32. Do not commit your real .env.
# After initial setup, normal website logins use the username/password and API_TOKEN is not required at server startup.
API_TOKEN=
# Optional comma-separated exact origins. Empty allows any domain, with network checks.
ALLOWED_ORIGINS=
PORT=8086
BIND_ADDRESS=127.0.0.1

# Local operator testing only: allow private/loopback targets and custom ports.
LOCAL_TESTING=false

# Set true for HTTPS deployments; false only for loopback development.
COOKIE_SECURE=false
